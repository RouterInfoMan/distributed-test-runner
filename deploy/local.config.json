{
  "listen": ":8080",
  "state_dir": "${DTP_ROOT}/.dtp/state",
  "public_url": "http://127.0.0.1:8080",
  "backend": "local",
  "local_runner_path": "${DTP_ROOT}/bin/dtp-runner",
  "default_timeout": "15m",
  "default_retries": 0,

  "s3": {
    "endpoint": "http://127.0.0.1:9000",
    "region": "us-east-1",
    "bucket": "dtp",
    "access_key": "dtpadmin",
    "secret_key": "dtpadmin123"
  },

  "pools": [
    {
      "name": "linux-container",
      "description": "Headless RCP under Xvfb in a container",
      "runtime": "container",
      "slot": { "cpu": 500, "memory": 512, "disk": 512 },
      "cache_dir": "${DTP_ROOT}/.dtp/cache/linux-container",
      "default": { "command": ["${DTP_ROOT}/examples/fixtures/rcp-suite.sh"] }
    },
    {
      "name": "linux-process",
      "description": "Directory sandbox + process cgroup on a provisioned node",
      "runtime": "process",
      "task_driver": "exec",
      "slot": { "cpu": 500, "memory": 512, "disk": 512 },
      "cache_dir": "${DTP_ROOT}/.dtp/cache/linux-process",
      "default": { "command": ["${DTP_ROOT}/examples/fixtures/rcp-suite.sh"] }
    }
  ],

  "local_nodes": [
    { "name": "sim-container-1", "pool": "linux-container", "slots": 3,
      "meta": { "os": "linux", "display": "xvfb", "rcp_version": "4.30" } },
    { "name": "sim-container-2", "pool": "linux-container", "slots": 3,
      "meta": { "os": "linux", "display": "xvfb", "rcp_version": "4.30" } },
    { "name": "sim-process-1", "pool": "linux-process", "slots": 2,
      "meta": { "os": "linux", "display": "xvfb", "rcp_version": "4.30" } },
    { "name": "sim-process-legacy", "pool": "linux-process", "slots": 1,
      "meta": { "os": "linux", "display": "xvfb", "rcp_version": "4.26" } }
  ]
}
