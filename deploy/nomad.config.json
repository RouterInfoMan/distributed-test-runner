{
  "listen": ":8080",
  "state_dir": "/var/lib/dtp",
  "public_url": "http://master:8080",
  "backend": "nomad",
  "store": {
    "driver": "postgres",
    "dsn": "postgres://dtp:dtp-s3cret@postgres:5432/dtp?sslmode=disable"
  },
  "templates_dir": "/etc/dtp/templates",
  "default_timeout": "20m",
  "default_retries": 0,
  "nomad": {
    "address": "http://nomad-server:4646",
    "datacenters": [
      "dc1"
    ]
  },
  "s3": {
    "endpoint": "http://minio:9000",
    "public_url": "http://127.0.0.1:9000",
    "region": "us-east-1",
    "bucket": "dtp",
    "builds_bucket": "builds",
    "access_key": "dtpadmin",
    "secret_key": "dtpadmin123"
  },
  "//": "Pools, node assignments, groups, users and quota rules are not here: they live in PostgreSQL (deploy/sql/010_seed_catalog.sql seeds the demo lab at first init). Slot counts and sizes live on the nodes (deploy/nodes/*.yaml). See README > Pools, nodes and quotas."
}
