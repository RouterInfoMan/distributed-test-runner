{
  "name": "simulated-nightly",
  "priority": 50,
  "labels": {
    "branch": "master",
    "trigger": "nightly",
    "simulated": "true"
  },
  "defaults": {
    "pool": "global",
    "timeout": "10m",
    "retries": 0,
    "requires": {
      "os": "linux",
      "display": "xvfb"
    },
    "env": {
      "FIXTURE_SECONDS": "20",
      "FIXTURE_TESTS": "24"
    }
  },
  "suites": [
    {
      "name": "simulated.jgit.test",
      "env": {
        "FIXTURE_TESTS": "40",
        "FIXTURE_SECONDS": "25"
      }
    },
    {
      "name": "simulated.jgit.pgm.test",
      "env": {
        "FIXTURE_TESTS": "18",
        "FIXTURE_SECONDS": "15"
      }
    },
    {
      "name": "simulated.core.test",
      "env": {
        "FIXTURE_TESTS": "30",
        "FIXTURE_SECONDS": "20"
      },
      "pool": "mid-pool"
    },
    {
      "name": "simulated.ui.test",
      "requires": {
        "perf": "high"
      },
      "timeout": "15m",
      "env": {
        "FIXTURE_TESTS": "26",
        "FIXTURE_FAIL": "2",
        "FIXTURE_SECONDS": "30"
      },
      "pool": "high-perf-pool"
    },
    {
      "name": "simulated.smartimport.test",
      "pool": "dev-pool",
      "env": {
        "FIXTURE_TESTS": "12",
        "FIXTURE_SECONDS": "18"
      }
    },
    {
      "name": "simulated.gitflow.test",
      "pool": "dev-pool",
      "env": {
        "FIXTURE_TESTS": "16",
        "FIXTURE_SECONDS": "22"
      }
    },
    {
      "name": "simulated.flaky.ui.test",
      "pool": "dev-pool",
      "retries": 2,
      "env": {
        "FIXTURE_TESTS": "14",
        "FIXTURE_FAIL": "3",
        "FIXTURE_FLAKY": "1",
        "FIXTURE_SECONDS": "12"
      }
    },
    {
      "name": "simulated.dev2.test",
      "pool": "dev-pool",
      "env": {
        "FIXTURE_TESTS": "10",
        "FIXTURE_SECONDS": "14"
      }
    },
    {
      "name": "simulated.crash.test",
      "retries": 1,
      "env": {
        "FIXTURE_CRASH": "1"
      }
    }
  ],
  "//": "SIMULATED: examples/fixtures/rcp-suite.sh generates surefire XML, an eclipse.log and rendered mock screenshots; no product runs. FIXTURE_* env knobs per suite: TESTS, FAIL, SKIP, SECONDS, FLAKY (fail only on attempt 1), CRASH (exit 42, no results). For real suites see egit.json."
}
