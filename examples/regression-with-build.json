{
  "name": "egit-with-build",
  "priority": 60,

  "defaults": {
    "pool": "linux-container",
    "timeout": "10m",
    "requires": { "os": "linux", "display": "xvfb" },
    "build": [
      {
        "name": "product",
        "url": "${BUILD_URL}",
        "sha256": "${BUILD_SHA256}",
        "unpack": "tar.gz"
      }
    ],
    "env": {
      "FIXTURE_TESTS": "12",
      "FIXTURE_SECONDS": "10"
    },
    "//": "Set DTP_TEST_APPLICATION in env to launch the real Eclipse test application instead of the fixture, e.g. org.eclipse.test.uitestapplication"
  },

  "suites": [
    { "name": "org.eclipse.jgit.test" },
    { "name": "org.eclipse.egit.core.test" },
    { "name": "org.eclipse.egit.ui.test" },
    { "name": "org.eclipse.egit.gitflow.test", "pool": "linux-process" },
    { "name": "org.eclipse.egit.ui.smartimport.test", "pool": "linux-process" }
  ]
}
